# Real logs (never commit)
*.ndjson
*.log
data/real/
# synthetic data is the only log-format data allowed in the repo
!data/synthetic/
!data/synthetic/**/*.ndjson

# OS / editor
.DS_Store
.vscode/
.idea/

# Env / secrets
.env
.env.*
!.env.example
.keys
.keys/

# Local Claude Code settings
.claude/settings.local.json

# Dependencies / build
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/

# Generated reports (rebuild with scripts/build_report.py)
out/

# Managed Agents resource IDs (written by `ant apply`; keep org IDs out of the public repo)
claude-lock.json
